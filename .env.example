# Tok configuration template
#
# Copy this file to .env (ignored by git). `make run` imports .env once into Settings and
# Keychain. Delete any line to leave that setting untouched. Import skips HISTORY_DB and
# HISTORY_RETENTION_DAYS; change those in Settings. Values below are the built-in
# defaults; README.md has the full reference.

# Gemini API key (required). Create one at https://aistudio.google.com/
# Saved to Keychain on import; never stored in preferences.
GEMINI_API_KEY=

# ---- General ----

# Dictation shortcut: Hold this key to dictate. Fn requires “Do Nothing” in Keyboard settings.
# Values: one of fn, right_option, left_option, right_control, left_control, right_cmd, left_cmd, f13, f14, f15, f16, f17, f18, f19, f20
HOTKEY=fn

# Shortcut behavior: Hold to speak, or press once to start and again to finish.
# Values: one of push_to_talk, toggle
HOTKEY_MODE=push_to_talk

# Hold to lock: Seconds before a held shortcut locks recording. Zero disables it.
# Values: 0 to 60
HOLD_TO_LOCK=15.0

# Locked recording limit: Maximum seconds for hands-free recording. Zero removes the limit. Every dictation still ends before the 10 minute live session limit.
# Values: 0 to 600
LOCK_LIMIT=120.0

# Play dictation sounds: Quiet cues when recording starts, finishes, locks, or fails.
# Values: true or false
SOUND_FEEDBACK=false

# Play a release cue: An additional short cue when you release the shortcut.
# Values: true or false
RELEASE_SOUND=false

# Restore clipboard: Put your previous clipboard back after pasting, unless you copied something new.
# Values: true or false
RESTORE_CLIPBOARD=true

# Add a trailing space: Keep consecutive dictations separated.
# Values: true or false
TRAILING_SPACE=true

# Typing speed: Your typing speed. Stats uses it to estimate the time dictation saves.
# Values: 10 to 200
TYPING_WPM=40

# ---- Transcription ----

# Clean up during live transcription: Ask the live model to remove fillers and format numbers and dates, using the existing transcription request.
# Values: true or false
SMART_TRANSCRIPTION=true

# Polish dictations before pasting: Send the transcript through an optional cleanup pass for punctuation, numbers, and lists. Adds response time and API usage. Off by default.
# Values: true or false
POST_PROCESS_ENABLED=false

# Adapt formatting to the app: When cleanup is enabled, include the destination app name and identifier. Window titles and contents are not sent.
# Values: true or false
POST_PROCESS_APP_CONTEXT=false

# Languages: Comma-separated language codes, such as en-IN,hi-IN,mr-IN. Use auto for unrestricted recognition.
# Values: text
LANGUAGE_CODES=en-IN,hi-IN,mr-IN

# ---- Audio ----

# Microphone: System Default follows your Mac’s sound settings. Automatic uses the built-in microphone with the lid open and an external microphone with it closed.
# Values: empty for system default, auto, or a device name
INPUT_DEVICE=

# Keep microphone ready: Keep capturing between dictations for pre-roll. macOS will show microphone use while idle.
# Values: true or false
KEEP_MICROPHONE_WARM=false

# Release an idle microphone: Seconds before releasing warm capture. Zero keeps it open. Applies only when “Keep microphone ready” is on.
# Values: 0 to 7200
MIC_IDLE_TIMEOUT=300

# Lower other audio while dictating: Restore the volume after capture. Your manual volume changes take priority.
# Values: true or false
DUCK_AUDIO=false

# Background volume fraction: How much output volume to keep while dictating, from zero to one.
# Values: 0 to 1
DUCK_FRACTION=0.2

# ---- Appearance ----

# Show dictation overlay: A small overlay follows your dictation without taking keyboard focus.
# Values: true or false
SHOW_HUD=true

# Follow the focused display: Show the overlay on the display where you are writing.
# Values: true or false
HUD_FOLLOW_FOCUS=true

# Overlay motion: Preview the entrance and exit before choosing.
# Values: one of drift, slide, bloom, unfurl, morph
HUD_REVEAL=drift

# Ambient particles: Optional particles while listening. Disabled with Reduce Motion.
# Values: true or false
HUD_PARTICLES=false

# ---- Vocabulary ----

# Additional terms: Comma-separated words or wrong => right replacements.
# Values: text
CUSTOM_VOCABULARY=

# Vocabulary file: Edit terms and replacements in the Vocabulary window.
# Values: text
CUSTOM_VOCABULARY_FILE=vocabulary.txt

# Your work and terminology: Optional context to help vocabulary suggestions understand your domain.
# Values: text
ANALYZE_CONTEXT=

# Learn from typed corrections: Observe word corrections after a paste. Only word pairs are stored, never the surrounding field.
# Values: true or false
LEARN_CORRECTIONS=false

# Correction observation delay: Milliseconds after a paste before checking for a correction.
# Values: 2000 to 60000
LEARN_DELAY_MS=8000

# ---- Privacy ----

# Hide dictated words on screen: Hide live words in the overlay and menu. Local history is controlled separately.
# Values: true or false
PRIVACY_MODE=false

# Save dictation history: Store dictations locally on this Mac.
# Values: true or false
HISTORY=true

# History retention: Days to retain history. Zero keeps it indefinitely.
# Values: 0 to 3650
HISTORY_RETENTION_DAYS=0

# Track dictation stats: Count words, dictations, speaking time, and time saved in a local stats database. No transcripts are stored there.
# Values: true or false
STATS=true

# Track word usage: Count how often each word is dictated for the most and least used lists. Stored as per-day counts, never as sentences.
# Values: true or false
STATS_WORDS=true

# Share anonymous usage metrics: Off by default. Records counts, categories, and timing buckets only. Never transcripts, audio, vocabulary, or your API key. See PRIVACY.md.
# Values: true or false
SHARE_USAGE_METRICS=false

# ---- Advanced ----

# Live model: Used for streaming transcription.
# Values: text
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Fallback model: Used when the live connection cannot finish a dictation.
# Values: text
GEMINI_MODEL=gemini-3.5-flash-lite

# Vocabulary analysis model: Used only when you request suggestions from history.
# Values: text
ANALYZE_MODEL=gemini-3.7-flash

# Cleanup model: Default: Gemini 3.5 Flash-Lite. Update cleanup token prices if you choose another model.
# Values: text
POST_PROCESS_MODEL=gemini-3.5-flash-lite

# Maximum cleanup wait: Milliseconds before using the original transcript. Failed cleanup never blocks delivery indefinitely.
# Values: 500 to 10000
POST_PROCESS_TIMEOUT_MS=2500

# Stream while speaking: Use the live connection for lower settlement latency.
# Values: true or false
ENABLE_LIVE_WEBSOCKET=true

# Fallback delay: Seconds to wait before also trying the fallback route.
# Values: 0.1 to 30
REST_FALLBACK_TIMEOUT=4.0

# Streaming frame size: Milliseconds of audio sent in each streaming frame.
# Values: 20 to 500
CHUNK_MS=100

# Trailing silence: Milliseconds of synthetic silence sent to help finalize the final word.
# Values: 0 to 2000
SILENCE_FLUSH_MS=200

# Use aligned end signals: Send only the documented end-of-turn signal. Turn off to compare latency and last-word accuracy with the earlier triple signal.
# Values: true or false
WS_ENDPOINT_ALIGNED=true

# Pre-roll: Milliseconds retained before pressing the shortcut when warm capture is enabled.
# Values: 0 to 1000
PRE_ROLL_MS=400

# Trailing quiet window: Milliseconds of quiet needed before finishing capture.
# Values: 0 to 500
POST_ROLL_MS=250

# Minimum trailing capture: Milliseconds recorded after release even when the room is already quiet.
# Values: 0 to 250
POST_ROLL_MIN_MS=30

# Maximum trailing capture: Milliseconds to wait for speech after release, at most.
# Values: 0 to 5000
POST_ROLL_MAX_MS=1500

# Quiet threshold: Audio below this level in dBFS counts as quiet.
# Values: -80 to -10
TRAIL_SILENCE_DB=-40.0

# Noisy-room margin: In a noisy room, audio this many dB above the room's own level still counts as quiet. 0 uses the quiet threshold alone.
# Values: 0 to 20
QUIET_MARGIN_DB=8

# Speech boundary detection: Manual uses the shortcut. Tuned and automatic use server speech detection.
# Values: one of manual, tuned, auto
VAD_MODE=manual

# Server quiet window: Milliseconds of silence before the tuned server mode finishes speech.
# Values: 200 to 5000
VAD_SILENCE_MS=1500

# Live input price: US dollars per million tokens, used for cost estimates.
# Values: 0 to 1000
LIVE_INPUT_PRICE_PER_1M=3.50

# Live output price: US dollars per million tokens, used for cost estimates.
# Values: 0 to 1000
LIVE_OUTPUT_PRICE_PER_1M=21.00

# REST input price: US dollars per million tokens, used for cost estimates.
# Values: 0 to 1000
REST_INPUT_PRICE_PER_1M=0.30

# REST output price: US dollars per million tokens, used for cost estimates.
# Values: 0 to 1000
REST_OUTPUT_PRICE_PER_1M=2.50

# Cleanup input price: USD per million input tokens, for cost estimates. Default matches Gemini 3.5 Flash-Lite standard pricing.
# Values: 0 to 1000
POST_PROCESS_INPUT_PRICE_PER_1M=0.30

# Cleanup output price: USD per million output tokens, including reported thinking tokens. Costs remain unknown when usage is not reported.
# Values: 0 to 1000
POST_PROCESS_OUTPUT_PRICE_PER_1M=2.50

# History database path: Empty uses Tok’s Application Support folder.
# Values: text
HISTORY_DB=

# Diagnostic detail: Normal records essential events. Verbose includes additional engineering detail.
# Values: one of normal, verbose
LOG_LEVEL=normal

# Experiment label: Stored with each dictation so measurements can be grouped. Leave empty normally.
# Values: text
EXPERIMENT_TAG=
